
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isBcso() { return signedIn() && request.auth.token.bcso == true; }
    function isSupervision() {
      return signedIn() && (request.auth.token.supervision == true || request.auth.token.admin == true);
    }
    function isBcsa() {
      return isBcso() && (request.auth.token.bcsa == true || isSupervision());
    }
    function isParkRanger() {
      return isBcso() && (request.auth.token.parkRanger == true || isSupervision());
    }

    match /conversations/{conversationId} {
      // Conversation metadata is private. Citizen owner or authorized BCSO users only.
      allow read: if signedIn() &&
        (resource.data.citizenUid == request.auth.uid || isBcso());

      allow create: if signedIn() &&
        request.resource.data.citizenUid == request.auth.uid;

      allow update: if signedIn() &&
        (resource.data.citizenUid == request.auth.uid || isBcso());

      match /messages/{messageId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.citizenUid == request.auth.uid
          || isBcso()
        );

        allow create: if signedIn() && (
          (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.citizenUid == request.auth.uid
            && request.resource.data.senderType == "citizen"
            && request.resource.data.senderId == request.auth.uid
          )
          ||
          (isBcso() && request.resource.data.senderType == "bcso")
        );

        allow update: if signedIn() && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.citizenUid == request.auth.uid
          || isBcso()
        );
        allow delete: if false;
      }
    }

    // Server-only queue. Browser clients cannot inspect or forge Discord notifications.
    match /discordNotificationBatches/{id} {
      allow read, write: if false;
    }

    // Existing V2 collections can be added here as they are migrated.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
